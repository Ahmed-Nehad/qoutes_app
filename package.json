{
  "name": "quotes_app",
  "version": "1.0.0",
  "description": "app that send a quote to the users every day by email",
  "main": " ./dist/server.js",
  "scripts": {
    "build": "npx tsc",
    "build:watch": "npx tsc -w",
    "start": "npx tsc && node ./dist/server.js",
    "test": "npx tsx --test ./tests/**/*.test.ts",
    "test:unit": "npx tsx --test ./tests/unitTests/**/*.test.ts",
    "test:api": "set NODE_ENV=test&  npx tsx --test ./tests/apiTest/**/*.test.ts"
  },
  "author": "Ahmed Nehad",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.2",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.1",
    "@types/express": "^4.17.20",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/node": "^20.9.0",
    "@types/node-cron": "^3.0.10",
    "@types/nodemailer": "^6.4.13",
    "@types/supertest": "^2.0.16",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "tsx": "^4.1.3",
    "typescript": "^5.2.2"
  }
}
